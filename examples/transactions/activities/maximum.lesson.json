            "id": "t1_read_next",
            "kind": "read",
            "object": "balance_long"
          },
          {
            "id": "t1_write_two",
            "kind": "write",
            "object": "count_shared",
            "value": {
              "read": "t1_read_next",
              "add": -10000
            }
          },
          {
            "id": "t1_committed",
            "kind": "commit"
          }
        ]
      },
      {
        "id": "T2",
        "operations": [
          {
            "id": "t2_read_long",
