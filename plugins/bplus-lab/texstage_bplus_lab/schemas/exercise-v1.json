{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B+ operation exercise v1",
  "$ref": "#/$defs/exercise",
  "$defs": {
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "semantics",
        "leaf_capacity",
        "internal_capacity",
        "tree",
        "task"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "semantics": {
          "const": "bplus-operations-v1"
        },
        "leaf_capacity": {
          "type": "integer",
          "minimum": 3,
          "maximum": 6
        },
        "internal_capacity": {
          "type": "integer",
          "minimum": 3,
          "maximum": 6
        },
        "tree": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "nodes"
          ],
          "properties": {
            "root": {
              "type": "integer",
              "const": 0
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 31,
              "items": {
                "$ref": "#/$defs/page"
              }
            }
          }
        },
        "task": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "key"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "lookup",
                    "insert",
                    "delete"
                  ]
                },
                "key": {
                  "type": "integer",
                  "minimum": -9999,
                  "maximum": 9999
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "lower",
                "upper"
              ],
              "properties": {
                "kind": {
                  "const": "range"
                },
                "lower": {
                  "type": "integer",
                  "minimum": -9999,
                  "maximum": 9999
                },
                "upper": {
                  "type": "integer",
                  "minimum": -9999,
                  "maximum": 9999
                }
              }
            }
          ]
        }
      }
    },
    "page": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "keys",
            "next"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "kind": {
              "const": "leaf"
            },
            "keys": {
              "type": "array",
              "minItems": 0,
              "maxItems": 6,
              "items": {
                "type": "integer",
                "minimum": -9999,
                "maximum": 9999
              }
            },
            "next": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "keys",
            "children"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "kind": {
              "const": "internal"
            },
            "keys": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "integer",
                "minimum": -9999,
                "maximum": 9999
              }
            },
            "children": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              }
            }
          }
        }
      ]
    }
  }
}
