{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B+ operation facts v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "exercise",
        "answer",
        "operation",
        "replay",
        "claims",
        "read"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "exercise": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "answer": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "operation": {
          "enum": [
            "lookup",
            "range"
          ]
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "checked_repairs"
          ],
          "properties": {
            "state": {
              "const": "complete"
            },
            "checked_repairs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 0
            }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "keys",
            "separators",
            "height"
          ],
          "properties": {
            "path": {
              "const": true
            },
            "keys": {
              "type": "boolean"
            },
            "separators": {
              "type": "null"
            },
            "height": {
              "type": "null"
            }
          }
        },
        "read": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "leaves",
            "keys",
            "page_visits"
          ],
          "properties": {
            "path": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              }
            },
            "leaves": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              }
            },
            "keys": {
              "type": "array",
              "minItems": 0,
              "maxItems": 40,
              "items": {
                "type": "integer",
                "minimum": -9999,
                "maximum": 9999
              }
            },
            "page_visits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 22
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "exercise",
        "answer",
        "operation",
        "replay",
        "claims",
        "final",
        "metrics"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "exercise": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "answer": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "operation": {
          "enum": [
            "insert",
            "delete"
          ]
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "checked_repairs"
          ],
          "properties": {
            "state": {
              "const": "complete"
            },
            "checked_repairs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "keys",
            "separators",
            "height"
          ],
          "properties": {
            "path": {
              "const": true
            },
            "keys": {
              "type": "null"
            },
            "separators": {
              "type": "boolean"
            },
            "height": {
              "type": "boolean"
            }
          }
        },
        "final": {
          "$ref": "#/$defs/tree"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "height_before",
            "height_after",
            "leaf_count",
            "splits",
            "borrows",
            "merges"
          ],
          "properties": {
            "height_before": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "height_after": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "leaf_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 21
            },
            "splits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "borrows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "merges": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "exercise",
        "answer",
        "operation",
        "replay"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "exercise": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "answer": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "operation": {
          "enum": [
            "lookup",
            "range",
            "insert",
            "delete"
          ]
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason",
            "checked_repairs",
            "at",
            "node"
          ],
          "properties": {
            "state": {
              "const": "invalid"
            },
            "reason": {
              "enum": [
                "wrong-path",
                "wrong-scan",
                "extra-repair",
                "wrong-pending-node",
                "illegal-split",
                "wrong-separator",
                "illegal-donor",
                "illegal-merge"
              ]
            },
            "checked_repairs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "node": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "exercise",
        "answer",
        "operation",
        "replay"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "exercise": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "answer": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "operation": {
          "enum": [
            "insert",
            "delete"
          ]
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason",
            "checked_repairs",
            "at",
            "node"
          ],
          "properties": {
            "state": {
              "const": "incomplete"
            },
            "reason": {
              "const": "missing-repair"
            },
            "checked_repairs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "node": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "nodes"
      ],
      "properties": {
        "root": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 35,
          "items": {
            "$ref": "#/$defs/page"
          }
        }
      }
    },
    "page": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "keys",
            "next"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "kind": {
              "const": "leaf"
            },
            "keys": {
              "type": "array",
              "minItems": 0,
              "maxItems": 6,
              "items": {
                "type": "integer",
                "minimum": -9999,
                "maximum": 9999
              }
            },
            "next": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "keys",
            "children"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "kind": {
              "const": "internal"
            },
            "keys": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "integer",
                "minimum": -9999,
                "maximum": 9999
              }
            },
            "children": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              }
            }
          }
        }
      ]
    }
  }
}
