{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B+ lesson envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "title",
    "prompt",
    "exercise",
    "worked",
    "feedback"
  ],
  "properties": {
    "format": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "exercise": {
      "$ref": "#/$defs/exercise"
    },
    "worked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "explanation"
      ],
      "properties": {
        "answer": {
          "oneOf": [
            {
              "$ref": "#/$defs/lookup"
            },
            {
              "$ref": "#/$defs/range"
            },
            {
              "$ref": "#/$defs/update"
            }
          ]
        },
        "explanation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "de": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          }
        }
      }
    },
    "feedback": {
      "enum": [
        "on-reveal",
        "immediate"
      ]
    }
  },
  "$defs": {
    "page": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "keys",
            "next"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "kind": {
              "const": "leaf"
            },
            "keys": {
              "type": "array",
              "minItems": 0,
              "maxItems": 6,
              "items": {
                "type": "integer",
                "minimum": -9999,
                "maximum": 9999
              }
            },
            "next": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "keys",
            "children"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "kind": {
              "const": "internal"
            },
            "keys": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "integer",
                "minimum": -9999,
                "maximum": 9999
              }
            },
            "children": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              }
            }
          }
        }
      ]
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "semantics",
        "leaf_capacity",
        "internal_capacity",
        "tree",
        "task"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "semantics": {
          "const": "bplus-operations-v1"
        },
        "leaf_capacity": {
          "type": "integer",
          "minimum": 3,
          "maximum": 6
        },
        "internal_capacity": {
          "type": "integer",
          "minimum": 3,
          "maximum": 6
        },
        "tree": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "nodes"
          ],
          "properties": {
            "root": {
              "type": "integer",
              "const": 0
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 31,
              "items": {
                "$ref": "#/$defs/page"
              }
            }
          }
        },
        "task": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "key"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "lookup",
                    "insert",
                    "delete"
                  ]
                },
                "key": {
                  "type": "integer",
                  "minimum": -9999,
                  "maximum": 9999
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "lower",
                "upper"
              ],
              "properties": {
                "kind": {
                  "const": "range"
                },
                "lower": {
                  "type": "integer",
                  "minimum": -9999,
                  "maximum": 9999
                },
                "upper": {
                  "type": "integer",
                  "minimum": -9999,
                  "maximum": 9999
                }
              }
            }
          ]
        }
      }
    },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "keys"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        },
        "keys": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1,
          "items": {
            "type": "integer",
            "minimum": -9999,
            "maximum": 9999
          }
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "keys",
        "leaves"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        },
        "keys": {
          "type": "array",
          "minItems": 0,
          "maxItems": 40,
          "items": {
            "type": "integer",
            "minimum": -9999,
            "maximum": 9999
          }
        },
        "leaves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "repairs",
        "separators",
        "height"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        },
        "repairs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "node",
                  "left_count",
                  "separator"
                ],
                "properties": {
                  "op": {
                    "const": "split"
                  },
                  "node": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "left_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  },
                  "separator": {
                    "type": "integer",
                    "minimum": -9999,
                    "maximum": 9999
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "node",
                  "sibling"
                ],
                "properties": {
                  "op": {
                    "enum": [
                      "borrow",
                      "merge"
                    ]
                  },
                  "node": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "sibling": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  }
                }
              }
            ]
          }
        },
        "separators": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node",
              "keys"
            ],
            "properties": {
              "node": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "keys": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "integer",
                  "minimum": -9999,
                  "maximum": 9999
                }
              }
            }
          }
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    }
  }
}
