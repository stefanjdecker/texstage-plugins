{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B+ selection command v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "control_version",
    "actor",
    "answer_version"
  ],
  "properties": {
    "control_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "actor": {
      "type": "string",
      "maxLength": 64
    },
    "answer_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    }
  }
}
