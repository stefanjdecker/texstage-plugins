            {
              "id": "person",
              "label": {
                "en": "Person",
                "de": "Person"
              }
            },
            {
              "id": "email",
              "label": {
                "en": "Email",
                "de": "E-Mail"
              }
            },
            {
              "id": "workshop",
              "label": {
                "en": "Workshop",
                "de": "Workshop"
              }
            },
            {
              "id": "tutor",
              "label": {
                "en": "Tutor",
                "de": "Tutor"
              }
            },
            {
              "id": "room",
              "label": {
                "en": "Room",
                "de": "Raum"
              }
            },
            {
              "id": "building",
              "label": {
                "en": "Building",
                "de": "Gebäude"
              }
            }
          ],
          "fds": [
            {
              "id": "f1",
              "lhs": [
                "person"
              ],
              "rhs": [
                "email"
              ]
            },
            {
              "id": "f2",
              "lhs": [
                "email"
              ],
              "rhs": [
                "person"
              ]
            },
            {
              "id": "f3",
              "lhs": [
                "workshop"
              ],
              "rhs": [
                "tutor",
                "room"
              ]
            },
            {
              "id": "f4",
              "lhs": [
                "room"
              ],
              "rhs": [
                "building"
              ]
            }
          ],
          "task": {
            "mode": "closure",
            "start": [
              "workshop"
            ]
          }
        },
        "worked_answer": {
          "mode": "closure",
          "closure": [
            "workshop",
            "tutor",
            "room",
            "building"
          ],
          "steps": [
            "f3",
            "f4"
          ]
        },
        "explanation": {
          "en": "The workshop fixes its tutor and room; the room fixes the building.",
          "de": "Der Workshop bestimmt Tutor und Raum; der Raum bestimmt das Gebäude."
        },
        "feedback": "after-reveal"
      },
      "expected": {
        "closure": [
          "workshop",
          "tutor",
          "room",
          "building"
        ],
        "keys": [
          [
            "person",
            "workshop"
          ],
          [
            "email",
            "workshop"
          ]
        ]
      }
    },
