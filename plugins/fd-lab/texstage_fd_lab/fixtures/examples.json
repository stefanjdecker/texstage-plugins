            "en": "Functional dependencies and keys",
            "de": "Funktionale Abhängigkeiten und Schlüssel"
          },
          "prompt": {
            "en": "Compute the closure of {workshop}, showing each FD application.",
            "de": "Berechnen Sie den Attributabschluss von {workshop} und zeigen Sie jede FD-Anwendung."
