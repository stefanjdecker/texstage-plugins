{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalization Workshop views/participant-input-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase",
    "active",
    "phase_version",
    "answer_version",
    "answer",
    "status",
    "feedback",
    "worked"
  ],
  "properties": {
    "phase": {
      "enum": [
        "introduce",
        "open",
        "closed",
        "revealed"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "phase_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "answer_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "answer": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/answer"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "pending",
            "checked",
            "unavailable"
          ]
        }
      ]
    },
    "feedback": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/feedback"
        }
      ]
    },
    "worked": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/worked"
        }
      ]
    }
  },
  "$defs": {
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "normal_form",
            "witness"
          ],
          "properties": {
            "mode": {
              "enum": [
                "classify"
              ]
            },
            "normal_form": {
              "enum": [
                "1nf",
                "2nf",
                "3nf",
                "bcnf"
              ]
            },
            "witness": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    {
                      "enum": [
                        1,
                        2,
                        4,
                        8,
                        16,
                        32,
                        64,
                        128
                      ]
                    }
                  ],
                  "items": false
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "relations"
          ],
          "properties": {
            "mode": {
              "enum": [
                "decompose"
              ]
            },
            "relations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "normal_form",
        "missing",
        "lossless",
        "preserved",
        "witness",
        "lost_fd"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "normal_form": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "1nf",
                "2nf",
                "3nf",
                "bcnf"
              ]
            }
          ]
        },
        "missing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "lossless": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "preserved": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "witness": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                {
                  "enum": [
                    1,
                    2,
                    4,
                    8,
                    16,
                    32,
                    64,
                    128
                  ]
                }
              ],
              "items": false
            }
          ]
        },
        "lost_fd": {
          "type": "integer",
          "minimum": -1,
          "maximum": 31
        }
      }
    },
    "worked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "explanation"
      ],
      "properties": {
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    }
  }
}
