{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalization Workshop seed-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "attributes",
    "fds",
    "task"
  ],
  "properties": {
    "format": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
    },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12,
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,11}$"
      },
      "uniqueItems": true
    },
    "fds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          {
            "enum": [
              1,
              2,
              4,
              8,
              16,
              32,
              64,
              128
            ]
          }
        ],
        "items": false
      },
      "uniqueItems": true
    },
    "task": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "classify"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "target",
            "preserve"
          ],
          "properties": {
            "mode": {
              "enum": [
                "decompose"
              ]
            },
            "target": {
              "enum": [
                "3nf",
                "bcnf"
              ]
            },
            "preserve": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
