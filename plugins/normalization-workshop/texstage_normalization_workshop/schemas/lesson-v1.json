{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalization Workshop lesson-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "exercise",
    "worked_answer",
    "explanation"
  ],
  "properties": {
    "format": {
      "type": "integer",
      "const": 1
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "id",
        "title",
        "prompt",
        "attributes",
        "fds",
        "task"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "de"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "de": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "de"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "de": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12,
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,11}$"
              },
              "label": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "en",
                  "de"
                ],
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 48
                  },
                  "de": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 48
                  }
                }
              }
            }
          }
        },
        "fds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lhs",
              "rhs"
            ],
            "properties": {
              "lhs": {
                "type": "array",
                "minItems": 0,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12,
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,11}$"
                },
                "uniqueItems": true
              },
              "rhs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12,
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,11}$"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "task": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "classify"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "target",
                "preserve"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "decompose"
                  ]
                },
                "target": {
                  "enum": [
                    "3nf",
                    "bcnf"
                  ]
                },
                "preserve": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      }
    },
    "worked_answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "normal_form",
            "witness"
          ],
          "properties": {
            "mode": {
              "enum": [
                "classify"
              ]
            },
            "normal_form": {
              "enum": [
                "1nf",
                "2nf",
                "3nf",
                "bcnf"
              ]
            },
            "witness": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    {
                      "enum": [
                        1,
                        2,
                        4,
                        8,
                        16,
                        32,
                        64,
                        128
                      ]
                    }
                  ],
                  "items": false
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "relations"
          ],
          "properties": {
            "mode": {
              "enum": [
                "decompose"
              ]
            },
            "relations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    }
  }
}
