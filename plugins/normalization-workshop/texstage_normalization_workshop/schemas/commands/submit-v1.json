{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalization Workshop commands/submit-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase",
    "version",
    "answer"
  ],
  "properties": {
    "phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "normal_form",
            "witness"
          ],
          "properties": {
            "mode": {
              "enum": [
                "classify"
              ]
            },
            "normal_form": {
              "enum": [
                "1nf",
                "2nf",
                "3nf",
                "bcnf"
              ]
            },
            "witness": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    {
                      "enum": [
                        1,
                        2,
                        4,
                        8,
                        16,
                        32,
                        64,
                        128
                      ]
                    }
                  ],
                  "items": false
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "relations"
          ],
          "properties": {
            "mode": {
              "enum": [
                "decompose"
              ]
            },
            "relations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "uniqueItems": true
            }
          }
        }
      ]
    }
  }
}
