{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalization Workshop state-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase",
    "phase_version",
    "control_version",
    "active",
    "page",
    "counts",
    "selected",
    "shared",
    "share_checks",
    "topic"
  ],
  "properties": {
    "phase": {
      "enum": [
        "introduce",
        "open",
        "closed",
        "revealed"
      ]
    },
    "phase_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "control_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "active": {
      "type": "boolean"
    },
    "page": {
      "type": "integer",
      "minimum": 0,
      "maximum": 62
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received",
        "pending",
        "checked",
        "unavailable"
      ],
      "properties": {
        "received": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "checked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "selected": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "handle",
          "version"
        ],
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      }
    },
    "shared": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "handle",
          "version"
        ],
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      }
    },
    "share_checks": {
      "type": "boolean"
    },
    "topic": {
      "enum": [
        "summary",
        "lossless",
        "preservation"
      ]
    }
  }
}
