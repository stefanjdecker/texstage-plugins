    {
      "id": "independent-objects",
      "exercise": {
        "format": 1,
        "id": "independent",
        "language": "de",
        "title": {
          "de": "Transaktionen untersuchen",
          "en": "Investigating transactions"
        },
        "prompt": {
          "de": "Bestimmen Sie die Endwerte und untersuchen Sie die Konflikte.",
          "en": "Predict the final values and examine the conflicts."
        },
        "initial": {
          "x": 100,
          "y": 50
        },
        "transactions": [
          {
            "id": "T1",
            "operations": [
              {
                "id": "a1",
                "kind": "read",
                "object": "x"
              },
              {
                "id": "a2",
                "kind": "write",
                "object": "x",
                "value": {
                  "read": "a1",
                  "add": 10
                }
              },
              {
                "id": "a3",
                "kind": "commit"
              }
            ]
          },
          {
            "id": "T2",
            "operations": [
              {
                "id": "b1",
                "kind": "read",
                "object": "y"
              },
              {
                "id": "b2",
                "kind": "write",
                "object": "y",
                "value": {
                  "read": "b1",
                  "add": 20
                }
              },
              {
                "id": "b3",
                "kind": "commit"
              }
            ]
          }
        ],
        "schedule": [
          "a1",
          "b1",
          "a2",
          "b2",
          "b3",
          "a3"
        ],
        "task": {
          "repair": "conflict-serializable",
          "feedback": "staged"
        }
      },
      "expected": {
        "final": {
          "x": 110,
          "y": 70
        },
        "edges": [],
        "csr": true,
        "serial_orders": [
          [
            "T1",
            "T2"
          ],
          [
            "T2",
            "T1"
          ]
        ]
      }
    },
