{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12,
        "pattern": "^[a-z][a-z0-9_]{0,11}$"
      },
      "minItems": 0,
      "maxItems": 30
    }
  },
  "required": [
    "order"
  ],
  "additionalProperties": false
}
