{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/answer",
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "choices"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "$ref": "#/$defs/id"
              }
            ],
            "items": false
          }
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    }
  }
}
