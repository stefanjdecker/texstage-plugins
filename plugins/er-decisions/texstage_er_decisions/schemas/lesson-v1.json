{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "title",
    "exercise",
    "labels",
    "requirements_de",
    "solutions",
    "counterexamples"
  ],
  "properties": {
    "format": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "exercise": {
      "type": "object"
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "relationship",
        "attributes"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "en",
                  "de"
                ],
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "de": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                }
              }
            }
          }
        },
        "relationship": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "de"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "de": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "en",
                  "de"
                ],
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "de": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                }
              }
            }
          }
        }
      }
    },
    "requirements_de": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "solutions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer",
          "explanation"
        ],
        "properties": {
          "answer": {
            "$ref": "#/$defs/answer"
          },
          "explanation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "de"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "de": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              }
            }
          }
        }
      }
    },
    "counterexamples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer",
          "snapshot",
          "explanation"
        ],
        "properties": {
          "answer": {
            "$ref": "#/$defs/answer"
          },
          "snapshot": {
            "$ref": "#/$defs/id"
          },
          "explanation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "de"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "de": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              }
            }
          }
        }
      }
    },
    "points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  },
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "choices"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "$ref": "#/$defs/id"
              }
            ],
            "items": false
          }
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    }
  }
}
