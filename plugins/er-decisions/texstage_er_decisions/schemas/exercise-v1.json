{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "brief",
    "requirements",
    "model",
    "decisions",
    "snapshots",
    "worked_answers"
  ],
  "properties": {
    "format": {
      "const": "er-registration-v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "worked_answers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/answer"
      }
    }
  },
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "choices"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "$ref": "#/$defs/id"
              }
            ],
            "items": false
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "max": {
          "enum": [
            1,
            "many"
          ]
        }
      }
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "target",
            "options"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "role-bounds"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "value"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "value": {
                    "$ref": "#/$defs/bounds"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "target",
            "options"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "attribute-owner"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "value"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "value": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "target",
            "options"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "relationship-form"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "value"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "value": {
                    "$ref": "#/$defs/form"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form",
        "pair_unique"
      ],
      "properties": {
        "form": {
          "enum": [
            "relationship",
            "association-entity"
          ]
        },
        "pair_unique": {
          "type": "boolean"
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "relationship"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "relationship": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "roles",
            "attributes",
            "form",
            "pair_unique"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "roles": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "entity",
                  "min",
                  "max"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "entity": {
                    "$ref": "#/$defs/id"
                  },
                  "min": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "max": {
                    "enum": [
                      1,
                      "many"
                    ]
                  }
                }
              }
            },
            "attributes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "owner"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "type": {
                    "enum": [
                      "int",
                      "bool",
                      "text"
                    ]
                  },
                  "owner": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            },
            "form": {
              "enum": [
                "relationship",
                "association-entity"
              ]
            },
            "pair_unique": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "scalar": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "visibility",
        "expected",
        "requirements",
        "entities",
        "links"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "expected": {
          "enum": [
            "allow",
            "forbid"
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "entities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity",
              "ids"
            ],
            "properties": {
              "entity": {
                "$ref": "#/$defs/id"
              },
              "ids": {
                "type": "array",
                "minItems": 0,
                "maxItems": 32,
                "items": {
                  "$ref": "#/$defs/id"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "links": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "roles",
              "values"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "roles": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "$ref": "#/$defs/id"
                    },
                    {
                      "$ref": "#/$defs/id"
                    }
                  ],
                  "items": false
                }
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "$ref": "#/$defs/id"
                    },
                    {
                      "$ref": "#/$defs/scalar"
                    }
                  ],
                  "items": false
                }
              }
            }
          }
        }
      }
    }
  }
}
