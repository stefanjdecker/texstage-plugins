{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "phase": {
      "enum": [
        "introduce",
        "open",
        "closed",
        "revealed"
      ]
    },
    "phase_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "active": {
      "type": "boolean"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600
    },
    "demonstration": {
      "$ref": "#/$defs/demonstration"
    },
    "teaching": {
      "$ref": "#/$defs/teaching"
    }
  },
  "required": [
    "phase",
    "phase_version",
    "active",
    "count"
  ],
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "choices"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            ],
            "items": false
          }
        }
      }
    },
    "demonstration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "rationale": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        }
      },
      "required": [
        "answer",
        "model"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "relationship"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "uniqueItems": true
        },
        "relationship": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "roles",
            "attributes",
            "form",
            "pair_unique"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            },
            "roles": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "entity",
                  "min",
                  "max"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "entity": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "min": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "max": {
                    "enum": [
                      1,
                      "many"
                    ]
                  }
                }
              }
            },
            "attributes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "owner"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "type": {
                    "enum": [
                      "int",
                      "bool",
                      "text"
                    ]
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  }
                }
              }
            },
            "form": {
              "enum": [
                "relationship",
                "association-entity"
              ]
            },
            "pair_unique": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "teaching": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worked": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "answer": {
                "$ref": "#/$defs/answer"
              },
              "model": {
                "$ref": "#/$defs/model"
              },
              "explanation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "de": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  }
                },
                "required": [
                  "en",
                  "de"
                ]
              }
            },
            "required": [
              "answer",
              "model",
              "explanation"
            ]
          }
        },
        "counterexamples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "answer": {
                "$ref": "#/$defs/answer"
              },
              "snapshot": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "entities",
                  "links"
                ],
                "properties": {
                  "entities": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "entity",
                        "ids"
                      ],
                      "properties": {
                        "entity": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 24
                        },
                        "ids": {
                          "type": "array",
                          "minItems": 0,
                          "maxItems": 32,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 24
                          },
                          "uniqueItems": true
                        }
                      }
                    }
                  },
                  "links": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "roles",
                        "values"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 24
                        },
                        "roles": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "prefixItems": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 24
                              },
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 24
                              }
                            ],
                            "items": false
                          }
                        },
                        "values": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 4,
                          "items": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "prefixItems": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 24
                              },
                              {
                                "oneOf": [
                                  {
                                    "type": "integer",
                                    "minimum": -1000000,
                                    "maximum": 1000000
                                  },
                                  {
                                    "type": "boolean"
                                  },
                                  {
                                    "type": "string",
                                    "minLength": 0,
                                    "maxLength": 64
                                  }
                                ]
                              }
                            ],
                            "items": false
                          }
                        }
                      }
                    }
                  }
                }
              },
              "explanation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "de": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  }
                },
                "required": [
                  "en",
                  "de"
                ]
              }
            },
            "required": [
              "answer",
              "snapshot",
              "explanation"
            ]
          }
        }
      },
      "required": [
        "worked",
        "counterexamples"
      ]
    }
  }
}
