{
  "format": "er-registration-v1",
  "id": "registrations",
  "brief": {
    "en": "A community centre records people, workshops and registration status.",
    "de": "Ein Lernzentrum erfasst Personen, Workshops und den Anmeldestatus."
  },
  "requirements": [
    {
      "id": "person-many",
      "text": "A person may register for zero or more workshops."
    },
    {
      "id": "workshop-many",
      "text": "A workshop may have zero or more people."
    },
    {
      "id": "pair-unique",
      "text": "There is at most one registration for each person/workshop pair."
    },
    {
      "id": "status-pair",
      "text": "Each registration has one status, independently of other registrations."
    }
  ],
  "model": {
    "entities": [
      "person",
      "workshop"
    ],
    "relationship": {
      "id": "registration",
      "roles": [
