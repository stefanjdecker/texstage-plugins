{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "phase": {
      "enum": [
        "introduce",
        "open",
        "closed",
        "revealed"
      ]
    },
    "phase_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "active": {
      "type": "boolean"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "own": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "status": {
          "enum": [
            "pending",
            "saved",
            "unavailable"
          ]
        },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "checked",
                "mismatch",
                "invalid",
                "unavailable"
              ]
            },
            "correct": {
              "type": "boolean"
            },
            "cells": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          "required": [
            "code"
          ]
        }
      },
      "required": [
        "version",
        "answer",
        "status"
      ]
    },
    "worked": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "explanation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "de": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "required": [
            "en",
            "de"
          ]
        }
      },
      "required": [
        "answer",
        "explanation"
      ]
    }
  },
  "required": [
    "phase",
    "phase_version",
    "active",
    "count"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "literal": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 24
        },
        {
          "type": "boolean"
        }
      ]
    },
    "operand": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "a"
            },
            {
              "$ref": "#/$defs/id"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "v"
            },
            {
              "$ref": "#/$defs/literal"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "predicate": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "enum": [
              "eq",
              "ne",
              "lt",
              "le",
              "gt",
              "ge"
            ]
          },
          {
            "$ref": "#/$defs/operand"
          },
          {
            "$ref": "#/$defs/operand"
          }
        ],
        "items": false,
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 1,
      "maxItems": 3
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true
    },
    "node": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "rel"
            },
            {
              "$ref": "#/$defs/id"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "select"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/predicate"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "project"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/names"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "rename"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "$ref": "#/$defs/id"
                  },
                  {
                    "$ref": "#/$defs/id"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 1,
              "maxItems": 12
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "product"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/index"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "union"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/index"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "difference"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/index"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "join"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/predicate"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      ]
    },
    "tree": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "path"
      ],
      "properties": {
        "rule": {
          "enum": [
            "split-select",
            "push-select-left",
            "push-select-right",
            "product-to-join",
            "collapse-project"
          ]
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 0,
          "maxItems": 7
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 0,
      "maxItems": 8
    },
    "column": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "enum": [
            "int",
            "text",
            "bool"
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "header": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/column"
      },
      "minItems": 1,
      "maxItems": 12
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "tree"
          ],
          "properties": {
            "mode": {
              "const": "construct"
            },
            "tree": {
              "$ref": "#/$defs/tree"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "steps"
          ],
          "properties": {
            "mode": {
              "const": "rewrite"
            },
            "steps": {
              "$ref": "#/$defs/steps"
            }
          }
        }
      ]
    }
  }
}
