{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "literal": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 24
        },
        {
          "type": "boolean"
        }
      ]
    },
    "operand": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "a"
            },
            {
              "$ref": "#/$defs/id"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "v"
            },
            {
              "$ref": "#/$defs/literal"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "predicate": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "enum": [
              "eq",
              "ne",
              "lt",
              "le",
              "gt",
              "ge"
            ]
          },
          {
            "$ref": "#/$defs/operand"
          },
          {
            "$ref": "#/$defs/operand"
          }
        ],
        "items": false,
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 1,
      "maxItems": 3
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true
    },
    "node": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "rel"
            },
            {
              "$ref": "#/$defs/id"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "select"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/predicate"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "project"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/names"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "rename"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "$ref": "#/$defs/id"
                  },
                  {
                    "$ref": "#/$defs/id"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 1,
              "maxItems": 12
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "product"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/index"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "union"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/index"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "difference"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/index"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "join"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/index"
            },
            {
              "$ref": "#/$defs/predicate"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      ]
    },
    "tree": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "path"
      ],
      "properties": {
        "rule": {
          "enum": [
            "split-select",
            "push-select-left",
            "push-select-right",
            "product-to-join",
            "collapse-project"
          ]
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 0,
          "maxItems": 7
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 0,
      "maxItems": 8
    },
    "column": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "enum": [
            "int",
            "text",
            "bool"
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "header": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/column"
      },
      "minItems": 1,
      "maxItems": 12
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "exercise",
        "answer",
        "mode",
        "valid",
        "fixtures",
        "public"
      ],
      "properties": {
        "format": {
          "const": "relational-analysis-v1"
        },
        "exercise": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "answer": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "mode": {
          "const": "construct"
        },
        "valid": {
          "const": true
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "header",
              "relation"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "header": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "relation": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              }
            }
          },
          "minItems": 1,
          "maxItems": 4
        },
        "public": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trace",
            "cells"
          ],
          "properties": {
            "trace": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 15
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 256
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 1,
              "maxItems": 16
            },
            "cells": {
              "type": "integer",
              "minimum": 0,
              "maximum": 49152
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "exercise",
        "answer",
        "mode",
        "valid",
        "fixtures",
        "public",
        "proof"
      ],
      "properties": {
        "format": {
          "const": "relational-analysis-v1"
        },
        "exercise": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "answer": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "mode": {
          "const": "rewrite"
        },
        "valid": {
          "const": true
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "header",
              "relation"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "header": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "relation": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              }
            }
          },
          "minItems": 1,
          "maxItems": 4
        },
        "public": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trace",
            "cells"
          ],
          "properties": {
            "trace": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 15
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 256
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 1,
              "maxItems": 16
            },
            "cells": {
              "type": "integer",
              "minimum": 0,
              "maximum": 49152
            }
          }
        },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verified",
            "steps",
            "tree",
            "baseline_cells",
            "improved"
          ],
          "properties": {
            "verified": {
              "const": true
            },
            "steps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "tree": {
              "$ref": "#/$defs/tree"
            },
            "baseline_cells": {
              "type": "integer",
              "minimum": 0,
              "maximum": 49152
            },
            "improved": {
              "type": "boolean"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "exercise",
        "answer",
        "mode",
        "valid",
        "reason",
        "node",
        "step"
      ],
      "properties": {
        "format": {
          "const": "relational-analysis-v1"
        },
        "exercise": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "answer": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "mode": {
          "enum": [
            "construct",
            "rewrite"
          ]
        },
        "valid": {
          "const": false
        },
        "reason": {
          "enum": [
            "wrong-mode",
            "not-a-tree",
            "child-index",
            "postorder",
            "tree-depth",
            "unknown-relation",
            "operator-not-allowed",
            "unknown-attribute",
            "duplicate-attribute",
            "attribute-collision",
            "incompatible-headers",
            "type-mismatch",
            "unordered-type",
            "width-limit",
            "rule-not-allowed",
            "rule-not-applicable",
            "rule-path",
            "attribute-side-condition",
            "projection-side-condition"
          ]
        },
        "node": {
          "type": "integer",
          "minimum": -1,
          "maximum": 15
        },
        "step": {
          "type": "integer",
          "minimum": -1,
          "maximum": 7
        }
      }
    }
  ]
}
