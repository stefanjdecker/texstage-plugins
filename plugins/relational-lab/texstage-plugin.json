{
  "manifest_version": 2,
  "plugin_api": 1,
  "id": "io.github.stefanjdecker.relationallab",
  "version": "0.2.0",
  "description": "Bounded relational algebra with visual query editing, public previews and prepared lessons.",
  "license": "Apache-2.0",
  "capabilities": {
    "engines": {
      "io.github.stefanjdecker.relationallab.algebra": {
        "engine_api": 1,
        "module": "texstage_relational_lab/web/engine.worker.mjs",
        "assets": [
          "texstage_relational_lab/web/identity.mjs",
          "texstage_relational_lab/web/validation.mjs",
          "texstage_relational_lab/web/algebra.mjs",
          "texstage_relational_lab/web/rewrites.mjs"
        ],
        "seed_types": {
          ".json": "application/json"
        },
        "input": {
          "mode": "code",
          "label": "Query tree or rewrite steps (JSON)",
          "tokens": [
            "tree",
            "steps"
          ]
        },
        "canonical_format": "relational-analysis-v1",
        "summary_kinds": [
          "text"
        ],
        "state_policy": "fresh-per-submission",
        "result_data_schema": "texstage_relational_lab/schemas/analysis-result-v1.json"
      }
    },
    "content_types": {
      "io.github.stefanjdecker.relationallab.tree": {
        "content_api": 1,
        "authoring_hook": "tree",
        "state_hook": "tree",
        "state_schema": 1,
        "latex_packages": [
          "texstage_relational_lab/latex/texstage-relational-tree.sty"
        ],
        "evaluations": {
          "analysis": {
            "engine": "io.github.stefanjdecker.relationallab.algebra"
          }
        },
        "views": {
          "participant-input": "texstage_relational_lab/web/participant.mjs",
          "presenter-controls": "texstage_relational_lab/web/presenter-controls.mjs",
          "presenter-overlay": "texstage_relational_lab/web/lesson-overlay.mjs",
          "projector-overlay": "texstage_relational_lab/web/lesson-overlay.mjs"
        },
        "view_schemas": {
          "participant-input": "texstage_relational_lab/schemas/views/participant-input.json",
          "presenter-controls": "texstage_relational_lab/schemas/views/presenter-controls.json",
          "presenter-overlay": "texstage_relational_lab/schemas/views/presenter-overlay.json",
          "projector-overlay": "texstage_relational_lab/schemas/views/projector-overlay.json"
        },
        "messages": {
          "submit-tree": {
            "from": [
              "participant"
            ],
            "revision_policy": "latest",
            "schema": "texstage_relational_lab/schemas/commands/submit.json"
          },
          "submit-rewrite": {
            "from": [
              "participant"
            ],
            "revision_policy": "latest",
            "schema": "texstage_relational_lab/schemas/commands/submit.json"
          },
          "open": {
            "from": [
              "presenter"
            ],
            "revision_policy": "latest",
            "schema": "texstage_relational_lab/schemas/commands/control.json"
          },
          "close": {
            "from": [
              "presenter"
            ],
            "revision_policy": "latest",
            "schema": "texstage_relational_lab/schemas/commands/control.json"
          },
          "reveal": {
            "from": [
              "presenter"
            ],
            "revision_policy": "latest",
            "schema": "texstage_relational_lab/schemas/commands/control.json"
          },
          "select-answer": {
            "from": [
              "presenter"
            ],
            "revision_policy": "latest",
            "schema": "texstage_relational_lab/schemas/commands/select.json"
          },
          "select-demonstration": {
            "from": [
              "presenter"
            ],
            "revision_policy": "latest",
            "schema": "texstage_relational_lab/schemas/commands/select.json"
          }
        },
        "fallback": "static-slide"
      }
    }
  },
  "latex_namespace": "relational",
  "latex_exports": {
    "commands": [
      "relationaltree"
    ],
    "environments": []
  }
}
